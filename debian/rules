#!/usr/bin/make -f

# Debian packaging rules for LiteMon
# Uses CMake + Ninja for the actual build

PACKAGE = litemon
VERSION = $(shell dpkg-parsechangelog | sed -n 's/^Version: //p')

%:
	dh $@ --with cmake,ninja

override_dh_auto_configure:
	dh_auto_configure -B build/deb --G Ninja -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_BINDIR=/usr/bin \
		-DCMAKE_INSTALL_DATADIR=/usr/share

override_dh_auto_build:
	dh_auto_build

override_dh_auto_install:
	dh_auto_install --destdir=$(CURDIR)/debian/tmp

override_dh_clean:
	dh_clean
	rm -rf build/deb

.PHONY: override_dh_auto_configure override_dh_auto_build override_dh_auto_install